# Bot
BOT_TOKEN=your_bot_token
OWNER_ID=your_telegram_id
ADMIN_IDS=id1,id2
BOT_MODE=webhook
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PORT=3000
WEBHOOK_SECRET=your_secret
TZ=Europe/Kyiv

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Capacity Planning
MAX_TOTAL_USERS=5000000
MAX_CONCURRENT_USERS=50000
MAX_WIZARD_PER_MINUTE=500
MAX_ACTIONS_PER_USER_PER_MIN=20
MAX_TOTAL_CHANNELS=500000
MAX_CHANNEL_PUBLISH_PER_MIN=2000
MAX_MESSAGES_PER_MINUTE=30000
